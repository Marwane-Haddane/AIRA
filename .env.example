# AI Coloring (free Cloudflare Workers AI tier, ~90 drawings/day, resets 00:00 UTC)
# Copy this file to .env and fill in your own values. .env is git-ignored.
# Account ID: Cloudflare dashboard > Workers AI (or the right-hand panel of any zone).
# Token: My Profile > API Tokens > Create Token > "Workers AI" template.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Optional: another image-edit model on Workers AI
# CLOUDFLARE_AI_MODEL=@cf/black-forest-labs/flux-2-klein-4b
